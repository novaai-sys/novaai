{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in your Cloudflare account.
  "name": "novaai",
  // Wraps OpenNext's Worker and adds the review-sync Cron Trigger.
  "main": "custom-worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "novaai" }],
  // Google review sync every 15 minutes (UTC).
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true }
}
