{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in your Cloudflare account.
  "name": "novaai",
  // Wraps OpenNext's Worker and adds the review-sync Cron Trigger.
  "main": "custom-worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Environment variables are uploaded as secrets by scripts/cf-deploy.mjs
  // from the Workers Builds build variables, on every deploy. Plain-text
  // variables added in the dashboard are removed on deploy, so the build
  // variables stay the single source of truth.
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "novaai" }],
  // Google review sync every 15 minutes (UTC).
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true }
}
