# Copy to .env.local for local development, and add the same variables in
# your hosting provider (e.g. Vercel > Project > Settings > Environment Variables).
# .env.local is ignored by git. Never commit real secret keys.

# ---- Site ----
# Public URL, used for the Google OAuth redirect URI.
NEXT_PUBLIC_SITE_URL=https://getnovaai.app

# ---- Supabase: Project Settings > API ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# SECRET. Server only. Used by the Paddle webhook and to store Google tokens.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- OpenAI (SECRET, server only) ----
OPENAI_API_KEY=sk-your-key

# ---- Paddle Billing ----
NEXT_PUBLIC_PADDLE_ENV=production
# Client-side token: public by design, used by Paddle.js in the browser.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=live_f5bf3b12517a21152e113768ea0
# SECRET. Server only. Paddle > Developer tools > Authentication.
# Used to switch plans for existing subscribers and open the billing portal.
PADDLE_API_KEY=your_paddle_api_key
# SECRET. The secret key of the notification destination that points at
# https://getnovaai.app/api/webhooks/paddle (Paddle > Developer tools > Notifications).
PADDLE_WEBHOOK_SECRET=your_paddle_webhook_secret_here
# Price IDs are public.
NEXT_PUBLIC_PADDLE_PRICE_STARTER_MONTHLY=pri_01m7n382zz0q647trgv80a8qwj
NEXT_PUBLIC_PADDLE_PRICE_STARTER_ANNUAL=pri_01m7n3fkddxw4xrtcpj6xpcccv
NEXT_PUBLIC_PADDLE_PRICE_GROWTH_MONTHLY=pri_01m7n6kg1h3abrjjz2tea6s5dg
NEXT_PUBLIC_PADDLE_PRICE_GROWTH_ANNUAL=pri_01m7n6npgfg0yjev0f61121tvc

# ---- Google Business Profile (Google Cloud > APIs & Services > Credentials) ----
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# SECRET.
GOOGLE_CLIENT_SECRET=your-client-secret
# SECRET. Encrypts stored Google refresh tokens. Generate: openssl rand -base64 32
# Never change it after users connect, or their stored tokens can't be read.
GOOGLE_TOKEN_ENCRYPTION_KEY=generate-with-openssl-rand-base64-32
