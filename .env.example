# Copy to .env.local for local development, and add the same variables in
# your hosting provider (e.g. Vercel > Project > Settings > Environment Variables).
# .env.local is ignored by git. Never commit real secret keys.

# ---- Site ----
# Public URL, used for the Google OAuth redirect URI.
NEXT_PUBLIC_SITE_URL=https://getnovaai.app

# ---- Supabase: Project Settings > API ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# SECRET. Server only. Used by the Paddle webhook and to store Google tokens.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- OpenAI (SECRET, server only) ----
OPENAI_API_KEY=sk-your-key

# ---- Paddle Billing ----
NEXT_PUBLIC_PADDLE_ENV=production
# Client-side token: public by design, used by Paddle.js in the browser.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=live_f5bf3b12517a21152e113768ea0
# SECRET. Server only. Paddle > Developer tools > Authentication.
# Used to switch plans for existing subscribers and open the billing portal.
PADDLE_API_KEY=your_paddle_api_key
# SECRET. The secret key of the notification destination that points at
# https://getnovaai.app/api/webhooks/paddle (Paddle > Developer tools > Notifications).
PADDLE_WEBHOOK_SECRET=your_paddle_webhook_secret_here
# Price IDs are public.
NEXT_PUBLIC_PADDLE_PRICE_STARTER_MONTHLY=pri_01m7n382zz0q647trgv80a8qwj
NEXT_PUBLIC_PADDLE_PRICE_STARTER_ANNUAL=pri_01m7n3fkddxw4xrtcpj6xpcccv
NEXT_PUBLIC_PADDLE_PRICE_GROWTH_MONTHLY=pri_01m7n6kg1h3abrjjz2tea6s5dg
NEXT_PUBLIC_PADDLE_PRICE_GROWTH_ANNUAL=pri_01m7n6npgfg0yjev0f61121tvc

# ---- Google Business Profile (Google Cloud > APIs & Services > Credentials) ----
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# SECRET.
GOOGLE_CLIENT_SECRET=your-client-secret
# SECRET. Encrypts stored Google refresh tokens. Generate: openssl rand -base64 32
# Never change it after users connect, or their stored tokens can't be read.
GOOGLE_TOKEN_ENCRYPTION_KEY=generate-with-openssl-rand-base64-32

# ---- Automatic review sync (netlify/functions/sync-reviews.mts, every 15 min) ----
# SECRET. Protects /api/cron/sync-reviews. At least 16 characters.
# Generate: openssl rand -hex 32
CRON_SECRET=generate-with-openssl-rand-hex-32
# Optional. Milliseconds one sync call may spend before handing over to the
# next call. 4000 fits Netlify's default 10-second limit.
# SYNC_TIME_BUDGET_MS=4000

# ---- AI dispatcher: live demo and trial requests ----
# SECRET. Retell AI > Settings > API Keys. Used only on the server.
RETELL_API_KEY=key_your_retell_secret_key
# The agent the landing page demo talks to (Retell > Agents > agent ID).
# Use a copy of Jessica with a 3-minute maximum call duration.
RETELL_DEMO_AGENT_ID=agent_xxxxxxxxxxxxxxxx
# Optional demo limits over 24 hours (defaults 10 per visitor, 300 per site).
# Raise them while you test, e.g. 50 and 1000.
# DEMO_CALLS_PER_IP=10
# DEMO_CALLS_PER_DAY=300
# Optional: get each trial request instantly. A Discord or Slack incoming
# webhook URL, or a Make.com / Zapier webhook.
# TRIAL_NOTIFY_WEBHOOK_URL=

# ---- Job texts after each call (Retell webhook -> Telnyx SMS) ----
# Retell sends call events to https://getnovaai.app/api/webhooks/retell and
# signs them with your API key that has the "webhook" badge in Retell. Only
# set this if that key is different from RETELL_API_KEY.
# RETELL_WEBHOOK_KEY=key_with_webhook_badge
# SECRET. Telnyx > API Keys.
TELNYX_API_KEY=KEYxxxxxxxxxxxxxxxx
# Your Telnyx number that sends the texts (E.164). It must be on a messaging
# profile and an approved 10DLC campaign. If unset, texts are sent from the
# number the customer called.
TELNYX_FROM_NUMBER=+15125550199
# Optional: Telnyx > Messaging > your profile ID.
# TELNYX_MESSAGING_PROFILE_ID=
# Who gets the texts when a call's agent has no row in the `businesses`
# table (handy while you test with one agent). E.164 format.
# OWNER_SMS_TO=+15125550100
# OWNER_BUSINESS_NAME=Lone Star Air & Plumbing
